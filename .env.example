
# .env — LOCAL development (used with docker-compose.yml)

COMPOSE_PROFILES=dev  # Run WITHOUT node (no profile): leave empty or omit the line entirely, 'dev'  run WITH the node watcher
APP_ENV=local

# --- MySQL ---
MYSQL_HOST=mysql:3306
MYSQL_CONTAINER=gruff_mysql
MYSQL_DATABASE=gruff
MYSQL_USER=pablo
MYSQL_PASSWORD=************
MYSQL_ROOT_PASSWORD=************

# --- WordPress  ---
WORDPRESS_CONTAINER=gruff_wordpress
WORDPRESS_PORT=8080            # optional HTTP listener; unused while Caddy terminates TLS
WORDPRESS_SSL_PORT=8466
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_HOME=https://gruff.localhost:8466/api   # NO trailing slash
WORDPRESS_DEBUG=true
WORDPRESS_THEMENAME=gruff
ACF_PRO_LICENSE=

