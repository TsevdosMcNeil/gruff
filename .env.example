# --- phpMyAdmin / WP-CLI ---
PHPMYADMIN_CONTAINER=gruff_phpmyadmin
WPCLI_CONTAINER=gruff_wpcli
PHPMYADMIN_PORT=8566

# --- Caddy ---
CADDY_CONTAINER=gruff_caddy
CADDY_HOSTNAME=gruff.localhost
CADDY_PRODUCTION_DOMAIN=gruffarchitects.com

# --- React ---
FRONTEND_API_URL=https://gruff.localhost:8466/api/wp-json/
FRONTEND_API_CUSTOM_PREFIX=gruff-api/
FRONTEND_API_VERSION=wp/v2/
# fullPage.js licence key (the live build uses one; without it fullPage shows a licence warning)
FRONTEND_FULLPAGE_LICENSE=

# --- Node ---
NODE_CONTAINER=gruff_node
NODE_PORT=5266
