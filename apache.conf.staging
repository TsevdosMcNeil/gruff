# gruff
# /etc/apache2/sites-available/gruff.conf
#
# Template: new-wp-sage.sh replaces these placeholders for each project:
#   gruff      project slug (folder on the server: /srv/docker/gruff)
#   beta.gruff.tm-studio.co.uk       staging domain (CADDY_PRODUCTION_DOMAIN)
#   8466     port the WordPress container listens on (127.0.0.1)
#   8566     port the phpMyAdmin container listens on (127.0.0.1)
#   __LIVE_DOMAIN__  live site, only for the optional media offload (fill in by hand)
#
# Modules: a2enmod proxy proxy_http headers rewrite   (+ ssl for the media offload)
#
# IMPORTANT: certbot copies this VirtualHost into gruff-le-ssl.conf (port 443),
# which is the one that actually serves the site. If you change this file after
# running certbot, make the same change in the -le-ssl.conf file.
#
# test configuration via `sudo apachectl configtest`
# load changes via `sudo systemctl reload apache2`

<VirtualHost *:80>
    ServerName beta.gruff.tm-studio.co.uk

    # Equivalent of client_max_body_size 256m
    LimitRequestBody 268435456

    ProxyPreserveHost On
    ProxyRequests Off

    # ── Block the WordPress logs folder ─────────────────────────────────────────
    # debug.log / error.log live in the web root (mapped from ./logs).
    <Location "/logs/">
        Require all denied
    </Location>

    # ── phpMyAdmin under /pma/ (basic auth, /pma prefix stripped) ────────────────
    # More specific ProxyPass rules must come BEFORE the catch-all "/".
    RedirectMatch ^/pma$ /pma/

    ProxyPass        /pma/ http://127.0.0.1:8566/
    ProxyPassReverse /pma/ http://127.0.0.1:8566/

    <Location "/pma/">
        AuthType Basic
        AuthName "Restricted"
        AuthUserFile /srv/docker/gruff/.htpasswd-pma
        Require valid-user
    </Location>

    # ── Media offload (optional): serve local uploads if present, else pull from live ──
    # Uncomment the whole block and set __LIVE_DOMAIN__. It must stay BEFORE "ProxyPass /".
    #SSLProxyEngine On                      # required to proxy to an https upstream
    #
    ## Keep uploads OUT of the catch-all container proxy
    #ProxyPass /wp-content/uploads/ !
    #
    ## Existing files served straight off the bind-mounted disk (no container hop)
    ## Verify path:  realpath ./wordpress/wp-content/uploads
    #Alias /wp-content/uploads/ /srv/docker/gruff/wordpress/wp-content/uploads/
    #<Directory /srv/docker/gruff/wordpress/wp-content/uploads>
    #    Require all granted
    #    Options -Indexes
    #</Directory>
    #
    ## Missing file -> transparently proxy from the live site
    #RewriteEngine On
    #RewriteCond /srv/docker/gruff/wordpress%{REQUEST_URI} !-f
    #RewriteRule ^/wp-content/uploads/(.*)$ https://__LIVE_DOMAIN__/wp-content/uploads/$1 [P,L]
    #ProxyPassReverse /wp-content/uploads/ https://__LIVE_DOMAIN__/wp-content/uploads/
    #
    ## Make the upstream fetch look first-party (override the global ProxyPreserveHost On)
    #<Location /wp-content/uploads/>
    #    ProxyPreserveHost Off
    #    RequestHeader unset Referer
    #</Location>

    # ── WordPress (catch-all, must be the LAST ProxyPass) ─────────────────────────
    ProxyPass        / http://127.0.0.1:8466/
    ProxyPassReverse / http://127.0.0.1:8466/

    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    ProxyTimeout 300

    ErrorLog ${APACHE_LOG_DIR}/gruff_error.log
    CustomLog ${APACHE_LOG_DIR}/gruff_access.log combined

    # HTTP -> HTTPS redirect (added by certbot)
    RewriteEngine on
    RewriteCond %{SERVER_NAME} =beta.gruff.tm-studio.co.uk
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>
