# Caddyfile — Gruff (headless WordPress + React)
#
#   https://{$CADDY_HOSTNAME}:{$WORDPRESS_SSL_PORT}/       -> React dev server (node service)
#   https://{$CADDY_HOSTNAME}:{$WORDPRESS_SSL_PORT}/api/   -> WordPress (API at /api/wp-json, CMS login at /api/<slug>)
#   https://pma.{$CADDY_HOSTNAME}:{$WORDPRESS_SSL_PORT}/   -> phpMyAdmin
#
# Same layout as the live site, so the front end and the API share one origin (no CORS).
{
	# Local mkcert certificates only: no ACME, no HTTP->HTTPS redirect listener
	auto_https disable_redirects

	# Plain http:// on the HTTPS port (typed URL, or a redirect from Apache, which
	# doesn't know it's behind HTTPS) gets redirected to https:// on the same port,
	# instead of "Client sent an HTTP request to an HTTPS server".
	servers {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

{$CADDY_HOSTNAME}:{$WORDPRESS_SSL_PORT} {
	tls /etc/caddy/certs/local.pem /etc/caddy/certs/local-key.pem
	encode gzip

	# /api -> /api/
	redir /api /api/ 308

	# Media: serve the local copy if it exists, otherwise fetch it from the live site.
	# (The live site only answers on http, so the upstream is http://.)
	handle /api/wp-content/uploads/* {
		root * /srv
		@local file
		handle @local {
			file_server
		}
		handle {
			reverse_proxy http://{$CADDY_PRODUCTION_DOMAIN} {
				header_up Host {upstream_hostport}
			}
		}
	}

	# WordPress (REST API, CMS, assets). Path is passed through unchanged:
	# WordPress itself lives in /api inside the container.
	handle /api/* {
		reverse_proxy wordpress:80
	}

	# Everything else: the React app (client-side routes, hot-reload websocket)
	handle {
		reverse_proxy {$NODE_CONTAINER}:{$NODE_PORT}
	}
}

pma.{$CADDY_HOSTNAME}:{$WORDPRESS_SSL_PORT} {
	tls /etc/caddy/certs/local.pem /etc/caddy/certs/local-key.pem
	reverse_proxy phpmyadmin:80
}
